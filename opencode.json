{
  "$schema": "https://opencode.ai/config.json",
  "agent": {

    "analyze": {
      "mode": "subagent",
      "hidden": true,
      "color": "#4CAF50",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "allow" },
        "glob": { "*": "allow" },
        "grep": { "*": "allow" },
        "edit": { "*": "deny" },
        "bash": { "*": "deny" },
        "task": { "*": "deny" }
      }
    },

    "synthesize": {
      "mode": "subagent",
      "hidden": true,
      "color": "#2196F3",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "allow" },
        "glob": { "*": "allow" },
        "grep": { "*": "allow" },
        "edit": { "*": "deny" },
        "bash": { "*": "deny" },
        "task": { "*": "deny" }
      }
    },

    "discover": {
      "mode": "subagent",
      "hidden": true,
      "color": "#FF9800",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "allow" },
        "glob": { "*": "allow" },
        "grep": { "*": "allow" },
        "edit": { "*": "deny" },
        "bash": { "*": "deny" },
        "task": { "*": "deny" }
      }
    }
  },
  "command": {
    "analyze": {
      "description": "分析所有未完成单篇文献",
      "agent": "analyze",
      "subtask": true,
      "template": "agents/analyze.md"
    },
    "synthesize": {
      "description": "生成文献综述报告",
      "agent": "synthesize",
      "subtask": true,
      "template": "agents/synthesize.md"
    },
    "discover": {
      "description": "挖掘研究突破点",
      "agent": "discover",
      "subtask": true,
      "template": "agents/discover.md"
    }
  }
}
